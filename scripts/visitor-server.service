[Unit]
Description=Visitor Statistics Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/nginx/html
ExecStart=/usr/bin/python3 /usr/local/nginx/html/visitor-server.py --port 3001 --log-dir /usr/local/nginx/html/data
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target